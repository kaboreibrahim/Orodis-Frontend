# Les domaines sont des exemples, comme dans l'architecture du backend.

# URL de l'API Django, lue côté serveur uniquement (aussi nécessaire au build).
API_URL=https://api.delicesdorodis.ci/api/v1
NEXT_PUBLIC_SITE_URL=https://delicesdorodis.ci
# Secret partagé avec Django pour POST /api/revalidate (en-tête x-revalidate-secret).
REVALIDATE_SECRET=
# Secret partagé avec Django (même valeur que son FRONTEND_API_KEY), envoyé dans X-Frontend-Key avec
# l'IP du visiteur pour la limite d'envois par IP. Lu côté serveur uniquement : jamais de préfixe NEXT_PUBLIC_.
FRONTEND_API_KEY=
NEXT_PUBLIC_WHATSAPP=2250702578159
NEXT_PUBLIC_GOOGLE_MAPS_EMBED=
